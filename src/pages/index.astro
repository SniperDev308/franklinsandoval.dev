---
const name = "Franklin Sandoval";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Franklin Sandoval - Critical Facilities, BMS Operations and Data Center Infrastructure." />
    <title>Franklin Sandoval</title>

    <style>
      :root {
        --bg: #0b1f33;
        --surface: #18222d;
        --text: #f5f7fa;
        --muted: #a7b0ba;
        --accent: #2f80ed;
        --line: #263545;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
      }

      .container {
        width: min(1120px, 92%);
        margin: 0 auto;
      }

      header {
        border-bottom: 1px solid var(--line);
      }

      nav {
        min-height: 76px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .brand {
        font-weight: 700;
        letter-spacing: 0.02em;
      }

      .nav-links {
        display: flex;
        gap: 28px;
      }

      .nav-links a {
        color: var(--muted);
        text-decoration: none;
        font-size: 0.95rem;
      }

      .nav-links a:hover {
        color: var(--text);
      }

      main {
        min-height: calc(100vh - 76px);
        display: flex;
        align-items: center;
      }

      .hero {
        max-width: 820px;
        padding: 80px 0;
      }

      .eyebrow {
        color: var(--accent);
        font-size: 0.9rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        margin-bottom: 18px;
      }

      h1 {
        font-size: clamp(3rem, 8vw, 6rem);
        line-height: 0.95;
        letter-spacing: -0.04em;
        margin-bottom: 24px;
      }

      .role {
        font-size: clamp(1.15rem, 2.5vw, 1.6rem);
        color: var(--muted);
        max-width: 760px;
        line-height: 1.5;
      }

      .description {
        margin-top: 26px;
        max-width: 650px;
        color: var(--muted);
        line-height: 1.75;
        font-size: 1rem;
      }

      .actions {
        margin-top: 36px;
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 0 20px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        transition: 0.2s ease;
      }

      .btn-primary {
        background: var(--accent);
        color: white;
      }

      .btn-primary:hover {
        transform: translateY(-1px);
      }

      .btn-secondary {
        border: 1px solid var(--line);
        color: var(--text);
        background: transparent;
      }

      .btn-secondary:hover {
        border-color: var(--accent);
      }

      @media (max-width: 700px) {
        .nav-links {
          display: none;
        }

        .hero {
          padding: 56px 0;
        }
      }
    </style>
  </head>

  <body>
    <header>
      <div class="container">
        <nav>
          <div class="brand">FS</div>

          <div class="nav-links">
            <a href="#about">About</a>
            <a href="#experience">Experience</a>
            <a href="#projects">Projects</a>
            <a href="#contact">Contact</a>
          </div>
        </nav>
      </div>
    </header>

    <main>
      <div class="container">
        <section class="hero">
  <div class="hero-grid">

    <div class="hero-copy">
      <div class="eyebrow">
        Critical Infrastructure · Automation · Data Centers
      </div>

      <h1>{name}</h1>

      <p class="role">
        Critical Facilities · BMS Operations · Data Center Infrastructure
      </p>

      <p class="description">
        Data center infrastructure professional focused on mission-critical
        operations, building management systems, networking, controls, and
        intelligent infrastructure.
      </p>

      <div class="actions">
        <a class="btn btn-primary" href="#projects">
          View Projects
        </a>

        <a class="btn btn-secondary" href="#contact">
          Contact
        </a>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="system-card">
        <div class="system-header">
          <span>INFRASTRUCTURE</span>
          <span class="status-dot"></span>
        </div>

        <div class="system-line">
          <span>BMS Operations</span>
          <span>ACTIVE</span>
        </div>

        <div class="system-line">
          <span>Critical Facilities</span>
          <span>ONLINE</span>
        </div>

        <div class="system-line">
          <span>Network Infrastructure</span>
          <span>READY</span>
        </div>

        <div class="system-line">
          <span>Controls & Automation</span>
          <span>DEVELOPING</span>
        </div>
      </div>
    </div>

  </div>
</section>
    </div>
  </main>
</body>
</html>